# --- Wallet / CLOB auth ---
# Private key of the EOA that signs orders. NEVER commit this file with real values.
PK=
# Signature type: 0=EOA, 1=Email/Magic proxy, 2=Browser (Gnosis Safe) proxy.
# Confirm this against how your Polymarket wallet was created before going live.
SIGNATURE_TYPE=1
# Address that actually holds your funds (your Polymarket proxy wallet address).
# For signature_type 0 this is usually the same as the EOA address; for 1/2 it is the proxy address.
FUNDER=
# Derived CLOB API creds (filled in by scripts/setup_clob_credentials.py — do not hand-write these)
CLOB_API_KEY=
CLOB_API_SECRET=
CLOB_API_PASSPHRASE=

# --- Anthropic ---
ANTHROPIC_API_KEY=

# --- RPC ---
POLYGON_RPC_URL=https://polygon-rpc.com

# --- Safety ---
# true = log decisions, place no real orders. Must be explicitly set to false to go live.
DRY_RUN=true
