# --- Wallet auth ---
# Private key of the EOA that signs orders. NEVER commit this file with real values.
# This is all that's needed: SecureClient.create(private_key=PK) derives your
# deposit wallet address and CLOB API credentials automatically, and deploys
# the deposit wallet on first use if it isn't already deployed. Run
# scripts/setup_deposit_wallet.py once to see the address before depositing funds.
PK=

# --- Anthropic ---
ANTHROPIC_API_KEY=

# --- RPC (only used for the Chainlink BTC/USD cross-check read) ---
POLYGON_RPC_URL=https://polygon-rpc.com

# --- Safety ---
# true = log decisions, place no real orders. Must be explicitly set to false to go live.
DRY_RUN=true
